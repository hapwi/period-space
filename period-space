#!/usr/bin/env python3
"""Control the always-on double-space → period remapper (keyd)."""

from __future__ import annotations

import argparse
import fcntl
import hashlib
import hmac
import json
import os
import re
import shutil
import subprocess
import sys
import tempfile
import urllib.error
import urllib.request
from pathlib import Path

KEYD_DIR = Path("/etc/keyd")
# The bindings. Not a .conf, so keyd never loads it on its own; host configs include it.
INCLUDE = KEYD_DIR / "period-space.inc"
# The wildcard config period-space owns when nothing else claims the keyboard.
OWNED_CONF = KEYD_DIR / "period-space.conf"
SYSTEMD_DIR = Path("/etc/systemd/system")
DROPIN = SYSTEMD_DIR / "keyd.service.d" / "period-space.conf"
GUARD_PATH = SYSTEMD_DIR / "period-space-guard.path"
GUARD_SERVICE = SYSTEMD_DIR / "period-space-guard.service"
CLI_TARGET = Path("/usr/local/bin/period-space")
DEFAULT_CONFIG = Path("/usr/local/share/period-space/keyd.conf")
SERVICE = "keyd.service"
GUARD_UNIT = "period-space-guard.path"
LOCK = Path("/tmp/period-space.lock")
SCRIPT = Path(__file__).resolve()
GITHUB_REPO = "hapwi/period-space"
VERSION = "1.1.0"
LATEST_RELEASE_API = f"https://api.github.com/repos/{GITHUB_REPO}/releases/latest"
INSTALL_HINT = (
    "curl -fsSL https://hapwi.github.io/install/period-space.sh | bash"
)

MARKER = "# period-space: double-space -> period. Managed lines; `period-space off` removes them."
INCLUDE_LINE = f"include {INCLUDE.name}"
INCLUDE_RE = re.compile(rf"^\s*include\s+{re.escape(INCLUDE.name)}\s*$")
SECTION_RE = re.compile(r"^\s*\[([^\]]*)\]\s*$")
OWNED_HEADER = (
    "# Managed by period-space. Do not edit this file.\n"
    "# Edit ~/.config/period-space/keyd.conf and run `period-space reload` instead.\n"
)
DEFAULT_IDS = "[ids]\n*\n"

DROPIN_TEXT = """\
# Managed by period-space: bring keyd back if it crashes so double-space keeps working.
[Service]
Restart=on-failure
RestartSec=1
"""

GUARD_PATH_TEXT = f"""\
# Managed by period-space: whenever a keyd config is added or edited, make sure
# the double-space mapping is still included by whichever config owns the keyboard.
[Unit]
Description=Keep period-space attached to keyd configs

[Path]
PathModified={KEYD_DIR}
Unit=period-space-guard.service

[Install]
WantedBy=multi-user.target
"""

GUARD_SERVICE_TEXT = f"""\
# Managed by period-space.
[Unit]
Description=Re-attach period-space to keyd configs
After={SERVICE}

[Service]
Type=oneshot
ExecStart={CLI_TARGET} ensure --quiet
"""


# ---------------------------------------------------------------- paths


def xdg_config_home() -> Path:
    raw = os.environ.get("XDG_CONFIG_HOME")
    return Path(raw) if raw else Path.home() / ".config"


def xdg_data_home() -> Path:
    raw = os.environ.get("XDG_DATA_HOME")
    return Path(raw) if raw else Path.home() / ".local" / "share"


def user_config() -> Path:
    return xdg_config_home() / "period-space" / "keyd.conf"


def bundled_config() -> Path:
    return SCRIPT.parent / "keyd.conf"


def shared_config() -> Path:
    return xdg_data_home() / "period-space" / "keyd.conf"


def legacy_cli() -> Path:
    return Path.home() / ".local" / "bin" / "period-space"


def source_config() -> Path:
    for path in (user_config(), DEFAULT_CONFIG, shared_config(), bundled_config()):
        if path.is_file():
            return path
    raise SystemExit(
        "no keyd.conf found. Install with:\n"
        f"  {INSTALL_HINT}\n"
        f"or copy keyd.conf to {user_config()}"
    )


# ---------------------------------------------------------------- processes


def run(argv: list[str], *, check: bool = True) -> subprocess.CompletedProcess[str]:
    return subprocess.run(argv, check=check, text=True, capture_output=True)


def is_root() -> bool:
    return os.geteuid() == 0


def sudo(
    argv: list[str], *, check: bool = True, capture: bool = False
) -> subprocess.CompletedProcess[str]:
    if is_root():
        result = subprocess.run(argv, check=False, text=True, capture_output=capture)
    else:
        tty = Path("/dev/tty")
        stdin = None
        try:
            stdin = tty.open()
        except OSError:
            pass
        if stdin is not None:
            try:
                result = subprocess.run(
                    ["sudo", *argv], check=False, text=True, stdin=stdin, capture_output=capture
                )
            finally:
                stdin.close()
        elif sys.stdin.isatty():
            result = subprocess.run(["sudo", *argv], check=False, text=True, capture_output=capture)
        else:
            result = run(["sudo", "-n", *argv], check=False)
            if check and result.returncode != 0:
                raise SystemExit(
                    "sudo needs a password. Run this in a terminal:\n"
                    f"  {INSTALL_HINT}"
                )
    if check and result.returncode != 0:
        detail = (result.stderr or "").strip() if capture else ""
        raise SystemExit(detail or f"command failed: {' '.join(argv)}")
    return result


def root_read(path: Path) -> str | None:
    """Read a root-owned file, escalating only if plain reading is not allowed."""
    try:
        return path.read_text()
    except FileNotFoundError:
        return None
    except PermissionError:
        result = sudo(["cat", str(path)], check=False, capture=True)
        return result.stdout if result.returncode == 0 else None


def root_exists(path: Path) -> bool:
    try:
        return path.exists()
    except PermissionError:
        return sudo(["test", "-e", str(path)], check=False).returncode == 0


def root_write(path: Path, text: str) -> None:
    """Write a root-owned file. Existing files keep their mode and owner."""
    with tempfile.TemporaryDirectory(prefix="period-space-") as directory:
        source = Path(directory) / path.name
        source.write_text(text)
        if root_exists(path):
            sudo(["cp", str(source), str(path)])
        else:
            sudo(["install", "-D", "-m", "0644", str(source), str(path)])


def root_remove(path: Path) -> None:
    sudo(["rm", "-f", str(path)])


class Lock:
    """Serialise the guard and a hand-run command so they do not edit /etc/keyd at once."""

    def __init__(self, path: Path = LOCK) -> None:
        self.path = path
        self.fd = -1

    def __enter__(self) -> "Lock":
        try:
            self.fd = os.open(self.path, os.O_RDONLY | os.O_CREAT, 0o644)
            fcntl.flock(self.fd, fcntl.LOCK_EX)
        except OSError:
            self.fd = -1
        return self

    def __exit__(self, *_: object) -> None:
        if self.fd >= 0:
            fcntl.flock(self.fd, fcntl.LOCK_UN)
            os.close(self.fd)


def sudo_install_bytes(data: bytes, target: Path, mode: int) -> None:
    with tempfile.TemporaryDirectory(prefix="period-space-") as directory:
        source = Path(directory) / target.name
        source.write_bytes(data)
        source.chmod(mode)
        sudo(["install", "-d", "-m", "0755", str(target.parent)])
        sudo(["install", "-m", f"{mode:04o}", str(source), str(target)])


def keyd_check(path: Path) -> subprocess.CompletedProcess[str]:
    return sudo(["keyd", "check", str(path)], check=False, capture=True)


def keyd_active() -> bool:
    return run(["systemctl", "is-active", "--quiet", SERVICE], check=False).returncode == 0


def keyd_enabled() -> bool:
    return run(["systemctl", "is-enabled", "--quiet", SERVICE], check=False).returncode == 0


def guard_active() -> bool:
    return run(["systemctl", "is-active", "--quiet", GUARD_UNIT], check=False).returncode == 0


def restart_keyd() -> None:
    """`keyd reload` re-parses in-process and has crashed on us; a restart is the safe path."""
    sudo(["systemctl", "restart", SERVICE])
    if not keyd_active():
        log = run(
            ["journalctl", "-u", SERVICE, "-b", "--no-pager", "-o", "cat", "-n", "20"], check=False
        ).stdout
        raise SystemExit(f"keyd did not come back after restart:\n{log}")


# ---------------------------------------------------------------- keyd config text


class Ids:
    def __init__(self, wildcard: bool, keyboard_ids: bool) -> None:
        self.wildcard = wildcard
        self.keyboard_ids = keyboard_ids

    @property
    def matches_keyboards(self) -> bool:
        return self.wildcard or self.keyboard_ids


def is_comment(line: str) -> bool:
    stripped = line.strip()
    return not stripped or stripped.startswith("#")


def split_ids(text: str) -> tuple[str, str]:
    """Split a keyd config into its [ids] section and everything else."""
    ids: list[str] = []
    rest: list[str] = []
    in_ids = False
    for line in text.splitlines():
        match = SECTION_RE.match(line)
        if match:
            in_ids = match.group(1).strip() == "ids"
        (ids if in_ids else rest).append(line)
    ids_text = "\n".join(ids).rstrip() + "\n" if ids else ""
    rest_text = "\n".join(rest).rstrip() + "\n" if rest else ""
    return ids_text, rest_text


def parse_ids(text: str) -> Ids:
    ids_text, _ = split_ids(text)
    wildcard = False
    keyboard_ids = False
    for line in ids_text.splitlines()[1:]:
        if is_comment(line):
            continue
        value = line.strip()
        if value == "*":
            wildcard = True
        elif value.startswith("-") or value.startswith("m:"):
            continue
        else:
            keyboard_ids = True
    return Ids(wildcard, keyboard_ids)


def has_include(text: str) -> bool:
    return any(INCLUDE_RE.match(line) for line in text.splitlines())


def is_legacy_layout(text: str) -> bool:
    """period-space 1.0 wrote the whole config into period-space.conf instead of an include."""
    return not has_include(text) and "[afterspace]" in text


def carries_mapping(text: str) -> bool:
    return has_include(text) or is_legacy_layout(text)


def add_include(text: str) -> str:
    body = text.rstrip("\n")
    return f"{body}\n\n{MARKER}\n{INCLUDE_LINE}\n" if body else f"{MARKER}\n{INCLUDE_LINE}\n"


def strip_include(text: str) -> str:
    kept = [
        line
        for line in text.splitlines()
        if line.strip() != MARKER and not INCLUDE_RE.match(line)
    ]
    body = "\n".join(kept).rstrip("\n")
    return f"{body}\n" if body else ""


def owned_conf_text(ids_text: str) -> str:
    return OWNED_HEADER + ids_text + f"\n{MARKER}\n{INCLUDE_LINE}\n"


def split_user_config(text: str) -> tuple[str, str]:
    """User config → ([ids] section for period-space.conf, bindings for period-space.inc)."""
    ids_text, fragment = split_ids(text)
    if not ids_text:
        ids_text = DEFAULT_IDS
    return ids_text, fragment


def keyd_confs() -> list[Path]:
    try:
        names = os.listdir(KEYD_DIR)
    except FileNotFoundError:
        return []
    except PermissionError:
        out = sudo(
            ["find", str(KEYD_DIR), "-maxdepth", "1", "-name", "*.conf"], check=False, capture=True
        ).stdout
        names = [Path(line).name for line in out.splitlines() if line.strip()]
    return sorted(KEYD_DIR / name for name in names if name.endswith(".conf"))


def installed_state() -> tuple[str, str] | None:
    """(ids_text, fragment) as currently installed in /etc/keyd, or None if not installed."""
    fragment = root_read(INCLUDE)
    if fragment is None:
        return None
    owned = root_read(OWNED_CONF)
    ids_text = DEFAULT_IDS
    if owned is not None:
        found, _ = split_ids(owned)
        if found:
            ids_text = found
    return ids_text, fragment


# ---------------------------------------------------------------- sync


def sync_keyd(ids_text: str, fragment: str, *, quiet: bool = False) -> list[Path]:
    """Make the fragment reachable from every keyd config that owns a keyboard.

    keyd binds a device to exactly one .conf, and between two wildcard configs the winner is
    whichever readdir() happened to return first. So instead of competing with a second `*`
    file, period-space rides inside whichever configs already claim keyboards, and only owns
    a wildcard config of its own when nobody else does. Returns the paths it changed.
    """
    changed: list[Path] = []
    originals: dict[Path, str | None] = {}

    def say(msg: str) -> None:
        if not quiet:
            print(msg)

    def write(path: Path, text: str) -> None:
        originals.setdefault(path, root_read(path))
        root_write(path, text)
        changed.append(path)

    def remove(path: Path) -> None:
        originals.setdefault(path, root_read(path))
        root_remove(path)
        changed.append(path)

    def rollback() -> None:
        for path, text in originals.items():
            if text is None:
                root_remove(path)
            else:
                root_write(path, text)

    sudo(["install", "-d", "-m", "0755", str(KEYD_DIR)])

    if root_read(INCLUDE) != fragment:
        write(INCLUDE, fragment)

    # Configs keyd refuses to parse never bind a device, so they neither own the wildcard nor
    # get edited; a broken file stays exactly as its author left it.
    hosts: dict[Path, str] = {}
    for path in keyd_confs():
        if path == OWNED_CONF:
            continue
        text = root_read(path)
        if text is None or not parse_ids(text).matches_keyboards:
            continue
        if keyd_check(path).returncode != 0:
            say(f"skipping {path}: keyd already rejects it, leaving it alone")
            continue
        hosts[path] = text
    others_wildcard = [path for path, text in hosts.items() if parse_ids(text).wildcard]

    own_ids = parse_ids(ids_text)
    if own_ids.wildcard and others_wildcard:
        # A second `*` file would just gamble on readdir order. Ride inside theirs instead.
        if root_read(OWNED_CONF) is not None:
            say(f"{others_wildcard[0]} already matches all keyboards; removing {OWNED_CONF}")
            remove(OWNED_CONF)
    else:
        desired = owned_conf_text(ids_text)
        if root_read(OWNED_CONF) != desired:
            write(OWNED_CONF, desired)

    for path, text in hosts.items():
        if has_include(text):
            continue
        say(f"adding `{INCLUDE_LINE}` to {path}")
        write(path, add_include(text))

    for path in changed:
        if path.suffix != ".conf" or root_read(path) is None:
            continue
        check = keyd_check(path)
        if check.returncode != 0:
            rollback()
            sys.stderr.write(check.stdout)
            sys.stderr.write(check.stderr)
            raise SystemExit(f"keyd rejected {path}; every change was rolled back")

    return changed


def detach_keyd(*, quiet: bool = False) -> list[Path]:
    """Undo sync_keyd: strip the include from every config and remove period-space's files."""
    changed: list[Path] = []
    for path in keyd_confs():
        if path == OWNED_CONF:
            continue
        text = root_read(path)
        if text is None or not has_include(text):
            continue
        if not quiet:
            print(f"removing `{INCLUDE_LINE}` from {path}")
        root_write(path, strip_include(text))
        changed.append(path)
    for path in (OWNED_CONF, INCLUDE):
        if root_exists(path):
            root_remove(path)
            changed.append(path)
    return changed


def sync_units() -> bool:
    """Install the keyd drop-in and the guard units. Returns True if anything changed."""
    changed = False
    if root_read(DROPIN) != DROPIN_TEXT:
        root_write(DROPIN, DROPIN_TEXT)
        changed = True
    for path, text in ((GUARD_SERVICE, GUARD_SERVICE_TEXT), (GUARD_PATH, GUARD_PATH_TEXT)):
        if root_read(path) != text:
            root_write(path, text)
            changed = True
    if changed:
        sudo(["systemctl", "daemon-reload"])
    return changed


def remove_units() -> None:
    sudo(["systemctl", "disable", "--now", GUARD_UNIT], check=False, capture=True)
    for path in (GUARD_PATH, GUARD_SERVICE, DROPIN):
        if root_exists(path):
            root_remove(path)
    sudo(["systemctl", "daemon-reload"])


def attached_confs() -> list[Path]:
    return [
        path
        for path in keyd_confs()
        if (text := root_read(path)) is not None
        and parse_ids(text).matches_keyboards
        and carries_mapping(text)
    ]


def feature_on() -> bool:
    return bool(attached_confs()) and keyd_active()


def device_matches() -> list[tuple[str, str, str]]:
    """(device name, id, config path) for each device keyd bound since it last started."""
    result = run(["journalctl", "-u", SERVICE, "-b", "--no-pager", "-o", "cat"], check=False)
    if result.returncode != 0:
        return []
    lines = result.stdout.splitlines()
    start = 0
    for index, line in enumerate(lines):
        if "Starting keyd" in line:
            start = index
    matches: dict[str, tuple[str, str, str]] = {}
    pattern = re.compile(r"DEVICE: match\s+(\S+)\s+(\S+)\s+\((.*)\)")
    for line in lines[start:]:
        found = pattern.search(line)
        if found:
            device_id, conf, name = found.groups()
            matches[device_id] = (name, device_id, conf)
    return list(matches.values())


# ---------------------------------------------------------------- update


def http_get(url: str) -> bytes:
    req = urllib.request.Request(
        url,
        headers={
            "User-Agent": f"period-space/{VERSION}",
            "Accept": "application/vnd.github+json",
        },
    )
    try:
        with urllib.request.urlopen(req, timeout=30) as resp:
            return resp.read()
    except urllib.error.HTTPError as exc:
        raise SystemExit(f"download failed: {exc.code} {url}") from exc
    except urllib.error.URLError as exc:
        raise SystemExit(f"download failed: {exc.reason} ({url})") from exc


def parse_version(value: str) -> tuple[int, int, int]:
    match = re.fullmatch(r"v?(\d+)\.(\d+)\.(\d+)", value)
    if match is None:
        raise SystemExit(f"invalid release version: {value}")
    major, minor, patch = match.groups()
    return int(major), int(minor), int(patch)


def latest_release_tag() -> str:
    try:
        data: object = json.loads(http_get(LATEST_RELEASE_API))
    except (UnicodeDecodeError, json.JSONDecodeError) as exc:
        raise SystemExit("GitHub returned invalid release metadata") from exc
    if not isinstance(data, dict):
        raise SystemExit("GitHub returned invalid release metadata")
    tag = data.get("tag_name")
    if not isinstance(tag, str):
        raise SystemExit("latest GitHub release has no version tag")
    parse_version(tag)
    return tag


def release_base(tag: str) -> str:
    return f"https://github.com/{GITHUB_REPO}/releases/download/{tag}"


def verify_release_file(name: str, data: bytes, checksums: bytes) -> None:
    try:
        lines = checksums.decode("utf-8").splitlines()
    except UnicodeDecodeError as exc:
        raise SystemExit("release checksums are not valid text") from exc
    expected = None
    for line in lines:
        parts = line.split(maxsplit=1)
        if len(parts) == 2 and parts[1].lstrip("*") == name:
            expected = parts[0]
            break
    if expected is None:
        raise SystemExit(f"release checksum is missing for {name}")
    actual = hashlib.sha256(data).hexdigest()
    if not hmac.compare_digest(actual, expected):
        raise SystemExit(f"release checksum failed for {name}")


def confirm_update(version: str, assume_yes: bool) -> bool:
    if assume_yes:
        return True
    if not sys.stdin.isatty():
        print(f"Run `period-space update --yes` to install {version} noninteractively.")
        return False
    answer = input(f"Install period-space {version}? [y/N] ").strip().lower()
    return answer in {"y", "yes"}


def remove_legacy_cli() -> None:
    path = legacy_cli()
    if not path.is_file() or path == CLI_TARGET:
        return
    try:
        contents = path.read_text()
    except (OSError, UnicodeDecodeError):
        return
    if 'GITHUB_REPO = "hapwi/period-space"' in contents:
        try:
            path.unlink()
        except OSError:
            return
        print(f"removed old user-local CLI: {path}")


# ---------------------------------------------------------------- commands


def ensure_user_config() -> Path:
    dest = user_config()
    if dest.is_file():
        return dest
    src = source_config()
    dest.parent.mkdir(parents=True, exist_ok=True)
    dest.write_text(src.read_text())
    return dest


def require_keyd() -> None:
    if shutil.which("keyd") is None:
        raise SystemExit(
            "keyd is not installed. The installer can set it up on the major distros:\n"
            f"  {INSTALL_HINT}"
        )


def apply_user_config(*, quiet: bool = False) -> list[Path]:
    ids_text, fragment = split_user_config(ensure_user_config().read_text())
    with Lock():
        return sync_keyd(ids_text, fragment, quiet=quiet)


def cmd_on(_: argparse.Namespace) -> None:
    require_keyd()
    apply_user_config()
    sync_units()
    sudo(["systemctl", "enable", "--now", SERVICE])
    sudo(["systemctl", "enable", "--now", GUARD_UNIT])
    restart_keyd()
    attached = attached_confs()
    print("double-space → period is on (keyd is running)")
    print("attached to: " + ", ".join(str(path) for path in attached))


def cmd_off(_: argparse.Namespace) -> None:
    remove_units()
    with Lock():
        changed = detach_keyd()
    if changed and keyd_active():
        restart_keyd()
    print("double-space → period is off (keyd stays installed, mapping removed)")


def cmd_reload(_: argparse.Namespace) -> None:
    require_keyd()
    apply_user_config()
    sync_units()
    if keyd_active():
        restart_keyd()
        print("restarted keyd with the current period-space config")
    else:
        print("config installed; keyd is not running (use `period-space on`)")


def cmd_ensure(args: argparse.Namespace) -> None:
    """Re-attach the installed mapping to whichever configs own keyboards. Safe to run any time."""
    state = installed_state()
    if state is None:
        if not args.quiet:
            print("period-space is off; nothing to ensure")
        return
    if shutil.which("keyd") is None:
        return
    ids_text, fragment = state
    with Lock():
        changed = sync_keyd(ids_text, fragment, quiet=args.quiet)
    if changed and keyd_active():
        restart_keyd()
        if not args.quiet:
            print("restarted keyd")
    elif not args.quiet:
        print("period-space is attached to every keyboard config; nothing to do")


def cmd_install(args: argparse.Namespace) -> None:
    if SCRIPT != CLI_TARGET:
        sudo(["install", "-d", "-m", "0755", str(CLI_TARGET.parent)])
        sudo(["install", "-m", "0755", str(SCRIPT), str(CLI_TARGET)])
    if bundled_config().is_file():
        sudo(["install", "-d", "-m", "0755", str(DEFAULT_CONFIG.parent)])
        sudo(["install", "-m", "0644", str(bundled_config()), str(DEFAULT_CONFIG)])

    if not user_config().is_file():
        ensure_user_config()

    print(f"installed {CLI_TARGET}")
    print(f"default config: {DEFAULT_CONFIG}")
    print(f"your config:    {user_config()}")
    remove_legacy_cli()
    if args.enable:
        cmd_on(args)


def cmd_update(args: argparse.Namespace) -> None:
    tag = latest_release_tag()
    current_version = parse_version(VERSION)
    available_version = parse_version(tag)
    latest = tag.removeprefix("v")

    print(f"current version: {VERSION}")
    print(f"latest version:  {latest}")
    if available_version == current_version:
        print("period-space is already up to date")
        return
    if available_version < current_version:
        print("this build is newer than the latest release")
        return
    if not confirm_update(latest, args.yes):
        print("update cancelled")
        return

    base = release_base(tag)
    print(f"downloading period-space {latest}")
    checksums = http_get(f"{base}/SHA256SUMS")
    script_bytes = http_get(f"{base}/period-space")
    conf_bytes = http_get(f"{base}/keyd.conf")
    verify_release_file("period-space", script_bytes, checksums)
    verify_release_file("keyd.conf", conf_bytes, checksums)
    try:
        script_text = script_bytes.decode("utf-8")
        conf_text = conf_bytes.decode("utf-8")
    except UnicodeDecodeError as exc:
        raise SystemExit("downloaded files were not valid text") from exc

    if (
        not script_text.startswith("#!/usr/bin/env python3")
        or f'VERSION = "{latest}"' not in script_text
    ):
        raise SystemExit("downloaded CLI does not match the release version")
    if "[afterspace]" not in conf_text or "oneshot_timeout" not in conf_text:
        raise SystemExit("downloaded keyd.conf looks invalid")

    sudo_install_bytes(script_bytes, CLI_TARGET, 0o755)
    sudo_install_bytes(conf_bytes, DEFAULT_CONFIG, 0o644)
    print(f"updated period-space {VERSION} → {latest}")
    if user_config().is_file():
        print(f"left your config alone: {user_config()}")
    remove_legacy_cli()

    if feature_on():
        # The new CLI may lay out /etc/keyd differently; let it apply its own layout.
        result = subprocess.run([str(CLI_TARGET), "reload"], check=False)
        if result.returncode != 0:
            print("CLI is updated. Apply keyd in a terminal with:")
            print("  period-space reload")


def cmd_status(_: argparse.Namespace) -> None:
    src = None
    try:
        src = source_config()
    except SystemExit:
        pass
    include_installed = root_read(INCLUDE)
    fragment_matches = False
    if src is not None and include_installed is not None:
        _, fragment = split_user_config(src.read_text())
        fragment_matches = include_installed == fragment

    print(f"version:        {VERSION}")
    print(f"config source:  {src if src else 'missing'}")
    print(f"user config:    {user_config()} ({'yes' if user_config().is_file() else 'no'})")
    print(f"bindings:       {INCLUDE} ({'yes' if include_installed is not None else 'no'}"
          f"{', matches source' if fragment_matches else ''})")
    print(f"keyd service:   {'active' if keyd_active() else 'inactive'}, "
          f"{'enabled' if keyd_enabled() else 'disabled'}"
          f"{', auto-restart' if root_read(DROPIN) is not None else ''}")
    print(f"guard:          {'active' if guard_active() else 'inactive'} ({GUARD_UNIT})")
    print(f"feature:        {'on' if feature_on() else 'off'}")
    if shutil.which("keyd") is None:
        print("keyd binary:    missing")

    confs = keyd_confs()
    print()
    print("keyd configs:")
    if not confs:
        print("  (none)")
    for path in confs:
        text = root_read(path)
        if text is None:
            print(f"  {path}: unreadable")
            continue
        ids = parse_ids(text)
        if path == OWNED_CONF:
            scope = "owned by period-space"
        elif ids.wildcard:
            scope = "all keyboards"
        elif ids.keyboard_ids:
            scope = "specific keyboards"
        else:
            scope = "no keyboards"
        if not ids.matches_keyboards:
            state = "n/a"
        elif has_include(text):
            state = "includes period-space"
        elif is_legacy_layout(text):
            state = "legacy 1.0 layout (run `period-space reload` to upgrade)"
        else:
            state = "MISSING period-space (run `period-space ensure`)"
        print(f"  {path}: {scope}, {state}")

    devices = device_matches()
    if devices:
        print()
        print("keyboards keyd is remapping right now:")
        for name, device_id, conf in devices:
            text = root_read(Path(conf))
            ok = text is not None and carries_mapping(text)
            print(f"  {name} ({device_id}) → {Path(conf).name}"
                  f"{'' if ok else '  <- period-space is NOT active here'}")


def main() -> None:
    parser = argparse.ArgumentParser(
        description="macOS-style period on double-space. keyd remaps at the device level so it works in terminals."
    )
    parser.add_argument("--version", action="version", version=f"%(prog)s {VERSION}")
    sub = parser.add_subparsers(dest="command", required=True)
    sub.add_parser("on", help="install the mapping and start keyd").set_defaults(func=cmd_on)
    sub.add_parser("off", help="remove the mapping").set_defaults(func=cmd_off)
    sub.add_parser("reload", help="apply your user config and restart keyd").set_defaults(func=cmd_reload)
    ensure = sub.add_parser(
        "ensure",
        help="re-attach the mapping to every keyd config that owns a keyboard",
    )
    ensure.add_argument("-q", "--quiet", action="store_true", help="only print problems")
    ensure.set_defaults(func=cmd_ensure)
    install = sub.add_parser("install", help="install the CLI system-wide")
    install.add_argument(
        "--enable",
        action="store_true",
        help="also install the keyd mapping and start the service",
    )
    install.set_defaults(func=cmd_install)
    update = sub.add_parser(
        "update",
        help="check for and install a newer GitHub release",
    )
    update.add_argument(
        "-y",
        "--yes",
        action="store_true",
        help="install without asking for confirmation",
    )
    update.set_defaults(func=cmd_update)
    sub.add_parser("status", help="show whether the mapping is active").set_defaults(func=cmd_status)
    args = parser.parse_args()
    args.func(args)


if __name__ == "__main__":
    main()
